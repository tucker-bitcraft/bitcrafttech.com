---
import Logo from './Logo.astro';

const navLinks = [
  { label: 'Services', href: '/#services' },
  { label: 'Projects', href: '/#projects' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header
  class="sticky top-0 z-50 border-b border-bc-border"
  style="background-color: rgba(13,13,13,0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <Logo height={50} />

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="font-mono text-sm text-bc-muted hover:text-bc-text hover:text-glow-green transition-all duration-200 tracking-wide"
        >
          {label}
        </a>
      ))}
      <a
        href="#contact"
        class="font-mono text-sm px-4 py-2 border border-green text-green hover:bg-green hover:text-bg-base transition-all duration-200 tracking-wide"
        style="border-radius: 2px;"
      >
        Get In Touch
      </a>
    </nav>

    <!-- Mobile nav: pure HTML details/summary, zero JS -->
    <details class="md:hidden group">
      <summary
        class="list-none cursor-pointer p-2 text-bc-muted hover:text-bc-text transition-colors"
        aria-label="Toggle navigation"
      >
        <!-- Hamburger icon -->
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" class="group-open:hidden">
          <rect y="4" width="22" height="1.5" rx="0.75" fill="currentColor"/>
          <rect y="10" width="22" height="1.5" rx="0.75" fill="currentColor"/>
          <rect y="16" width="22" height="1.5" rx="0.75" fill="currentColor"/>
        </svg>
        <!-- Close icon -->
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden group-open:block">
          <line x1="3" y1="3" x2="19" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="19" y1="3" x2="3" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </summary>
      <nav
        class="absolute top-16 left-0 right-0 border-b border-bc-border px-6 py-4 flex flex-col gap-4"
        style="background-color: rgba(13,13,13,0.97); backdrop-filter: blur(12px);"
        aria-label="Mobile navigation"
      >
        {navLinks.map(({ label, href }) => (
          <a
            href={href}
            class="font-mono text-sm text-bc-muted hover:text-green transition-colors tracking-wide"
          >
            {label}
          </a>
        ))}
        <a
          href="#contact"
          class="font-mono text-sm px-4 py-2 border border-green text-green text-center mt-2 hover:bg-green hover:text-bg-base transition-all"
          style="border-radius: 2px;"
        >
          Get In Touch
        </a>
      </nav>
    </details>
  </div>
</header>
