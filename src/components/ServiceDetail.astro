---
import type { ServiceItem } from '@/data/services';

type Props = ServiceItem & { index?: number };

const {
  slug,
  title,
  icon,
  accentColor = 'green',
  detail,
  whatYouGet,
  whoFor,
  outcome,
  index = 0,
} = Astro.props;

const accentText = accentColor === 'amber' ? 'text-amber' : 'text-green';
const accentBorder = accentColor === 'amber' ? 'border-amber' : 'border-green';
// Literal classes so Tailwind's JIT can see them (no dynamic `hover:${x}`).
const panelHover = accentColor === 'amber'
  ? 'hover:border-amber hover:glow-amber'
  : 'hover:border-green hover:glow-green';
const numberLabel = String(index + 1).padStart(2, '0');
// Alternate the visual side of the panel on wider screens.
const reversed = index % 2 === 1;
---

<article id={slug} class="scroll-mt-24 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
  <!-- Copy column -->
  <div class:list={[reversed ? 'lg:order-2' : 'lg:order-1']}>
    <div class="flex items-center gap-4 mb-5">
      <div
        class:list={['w-14 h-14 flex items-center justify-center border bg-bg-card flex-shrink-0', accentText, accentBorder]}
        style="border-radius: 5px;"
      >
        <span set:html={icon}></span>
      </div>
      <span class="font-mono text-sm text-bc-muted">// {numberLabel}</span>
    </div>

    <h2 class="text-3xl md:text-4xl font-bold text-bc-text leading-tight mb-4">{title}</h2>
    <p class="text-bc-muted text-lg leading-relaxed mb-6">{detail}</p>

    <div class="flex flex-wrap gap-x-8 gap-y-3 mb-2">
      <div>
        <p class="font-mono text-xs text-bc-muted tracking-widest uppercase mb-1">Who it's for</p>
        <p class="text-bc-text text-sm">{whoFor}</p>
      </div>
    </div>

    <div
      class:list={['inline-flex items-center gap-2 mt-4 font-mono text-sm', accentText]}
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h10M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {outcome}
    </div>
  </div>

  <!-- "What you get" panel -->
  <div class:list={[reversed ? 'lg:order-1' : 'lg:order-2']}>
    <div
      class:list={['bg-bg-card border border-bc-border p-8 transition-all duration-300', panelHover]}
      style="border-radius: 8px;"
    >
      <p class="font-mono text-xs tracking-widest uppercase mb-5" class:list={[accentText]}>// WHAT YOU GET</p>
      <ul class="space-y-4">
        {whatYouGet.map((item) => (
          <li class="flex items-start gap-3 text-bc-text text-sm leading-relaxed">
            <svg
              class:list={['mt-0.5 flex-shrink-0', accentText]}
              width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"
            >
              <path d="M3 8.5l3.2 3L13 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</article>
