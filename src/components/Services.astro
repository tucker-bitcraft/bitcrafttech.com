---
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';
import { services } from '@/data/services';
---

<section id="services" class="relative bg-bg-section py-32 clip-angle-both" style="padding-top: calc(5rem + 40px); padding-bottom: calc(5rem + 40px);">
  <div class="max-w-7xl mx-auto px-6">
    <SectionHeading
      label="// 01 SERVICES"
      title="What We Build"
      subtitle="Specialised expertise across the full engineering stack. No generalists, no hand-waving. Just solid engineering."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((service, i) => (
        <ServiceCard {...service} index={i} />
      ))}
    </div>
  </div>
</section>
