---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';

interface ProjectItem {
  title: string;
  description: string;
  tags: string[];
  link?: string;
  image?: string;
  status?: 'live' | 'wip' | 'archived';
}

const projects: ProjectItem[] = [
  {
    title: 'Echo',
    description: 'An AI Engine for persistant entities on a wide range of devices',
    tags: ['Python', 'Embedded', 'Linux'],
    status: 'wip',
  },
  {
    title: 'Medulla',
    description: 'Plug and play port-socket system, allowing a unified interface to execute commands',
    tags: ['python', 'PostgreSQL', 'Kubernetes'],
    status: 'live',
  },
  {
    title: 'Bit',
    description: 'A 4.5 foot robot comanion',
    tags: ['Python', 'ML Pipeline', 'Apache Kafka'],
    status: 'wip',
  },
  {
    title: 'Project Delta',
    description: 'An older project showing your range. Archived but a demonstration of prior work and technical breadth.',
    tags: ['C++', 'RTOS', 'CAN Bus'],
    status: 'archived',
  },
];
---

<section id="projects" class="relative bg-bg-base py-32" style="padding-top: calc(5rem + 40px);">
  <div class="max-w-7xl mx-auto px-6">
    <SectionHeading
      label="// 02 — PROJECTS"
      title="Selected Work"
      subtitle="A sample of things we've built."
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>

    <div class="mt-12 pt-8 border-t border-bc-border flex items-center justify-between flex-wrap gap-4">
      <p class="font-mono text-xs text-bc-muted tracking-wide">
        [ More projects available on request ]
      </p>
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono text-xs text-green hover:text-green-hi transition-colors tracking-wide"
      >
        View on GitHub
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>
