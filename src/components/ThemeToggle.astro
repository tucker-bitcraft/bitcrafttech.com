---
// Light/dark theme toggle. The initial theme is set before paint by the inline
// script in BaseLayout; this button just flips and persists it. Reusable,
// drop it anywhere; all instances stay in sync via the data-theme attribute.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle light and dark mode"
  title="Toggle theme"
  class="inline-flex items-center justify-center w-9 h-9 border border-bc-border text-bc-muted hover:text-bc-text hover:border-green transition-colors"
  style="border-radius: 2px;"
>
  <!-- Shown in dark mode (tap → switch to light) -->
  <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5"/>
    <path d="M12 2v2.5M12 19.5V22M22 12h-2.5M4.5 12H2M19.07 4.93l-1.77 1.77M6.7 17.3l-1.77 1.77M19.07 19.07l-1.77-1.77M6.7 6.7L4.93 4.93" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
  <!-- Shown in light mode (tap → switch to dark) -->
  <svg class="theme-icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>
</button>

<style>
  :global(html[data-theme='dark']) .theme-icon-moon { display: none; }
  :global(html[data-theme='light']) .theme-icon-sun { display: none; }
</style>

<script>
  // Flip the theme on every toggle button and persist the choice.
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* ignore storage failures (private mode, etc.) */
      }
    });
  });
</script>
