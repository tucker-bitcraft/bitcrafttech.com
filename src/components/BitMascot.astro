---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 320 } = Astro.props;
---

<div
  class:list={['relative inline-flex items-center justify-center', className]}
  style={`width: ${size}px; height: ${size}px; filter: drop-shadow(0 0 32px rgba(229, 92, 26, 0.35));`}
>
  <!-- Glow halo behind mascot -->
  <div
    class="absolute inset-0 rounded-full opacity-20"
    style="background: radial-gradient(circle, rgba(229,92,26,0.5) 0%, transparent 70%);"
  ></div>

  <!-- Inline placeholder SVG robot — replace with real art via public/bit-mascot.svg -->
  <svg
    width={size}
    height={size}
    viewBox="0 0 320 320"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="Bit, the Bitcraft Tech mascot"
  >
    <!-- Body -->
    <rect x="90" y="140" width="140" height="110" rx="8" fill="#E55C1A"/>
    <rect x="98" y="148" width="124" height="94" rx="4" fill="#C94E16"/>

    <!-- Chest panel -->
    <rect x="115" y="165" width="90" height="55" rx="3" fill="#1E1E1E" stroke="#333" stroke-width="1"/>
    <!-- Panel lights -->
    <circle cx="132" cy="182" r="6" fill="#4CAF75"/>
    <circle cx="132" cy="182" r="3" fill="#E8E0D0" opacity="0.8"/>
    <circle cx="160" cy="182" r="6" fill="#E8A020"/>
    <circle cx="160" cy="182" r="3" fill="#E8E0D0" opacity="0.8"/>
    <circle cx="188" cy="182" r="6" fill="#3E8B5E" opacity="0.6"/>
    <!-- Panel bar -->
    <rect x="125" y="200" width="70" height="7" rx="2" fill="#0D0D0D"/>
    <rect x="125" y="200" width="42" height="7" rx="2" fill="#4CAF75" opacity="0.7"/>

    <!-- Head -->
    <rect x="95" y="60" width="130" height="90" rx="10" fill="#E55C1A"/>
    <rect x="103" y="68" width="114" height="74" rx="6" fill="#C94E16"/>

    <!-- Eyes -->
    <rect x="115" y="80" width="36" height="28" rx="4" fill="#1E1E1E"/>
    <rect x="169" y="80" width="36" height="28" rx="4" fill="#1E1E1E"/>
    <!-- Eye glow -->
    <circle cx="133" cy="94" r="9" fill="#E8A020"/>
    <circle cx="133" cy="94" r="5" fill="#FFF3D0"/>
    <circle cx="136" cy="91" r="2" fill="#FFFFFF" opacity="0.9"/>
    <circle cx="187" cy="94" r="9" fill="#E8A020"/>
    <circle cx="187" cy="94" r="5" fill="#FFF3D0"/>
    <circle cx="190" cy="91" r="2" fill="#FFFFFF" opacity="0.9"/>

    <!-- Antenna -->
    <rect x="156" y="36" width="8" height="28" rx="3" fill="#C94E16"/>
    <circle cx="160" cy="32" r="9" fill="#E8A020"/>
    <circle cx="160" cy="32" r="5" fill="#FFF3D0"/>

    <!-- Neck connector -->
    <rect x="140" y="148" width="40" height="10" rx="2" fill="#C94E16"/>
    <rect x="148" y="150" width="24" height="6" rx="1" fill="#1E1E1E" opacity="0.4"/>

    <!-- Left arm -->
    <rect x="50" y="148" width="38" height="18" rx="6" fill="#E55C1A"/>
    <rect x="38" y="155" width="20" height="44" rx="6" fill="#E55C1A"/>
    <rect x="34" y="194" width="28" height="16" rx="5" fill="#C94E16"/>

    <!-- Right arm -->
    <rect x="232" y="148" width="38" height="18" rx="6" fill="#E55C1A"/>
    <rect x="262" y="155" width="20" height="44" rx="6" fill="#E55C1A"/>
    <rect x="258" y="194" width="28" height="16" rx="5" fill="#C94E16"/>

    <!-- Legs -->
    <rect x="112" y="248" width="38" height="48" rx="6" fill="#C94E16"/>
    <rect x="110" y="285" width="42" height="18" rx="5" fill="#1E1E1E"/>
    <rect x="170" y="248" width="38" height="48" rx="6" fill="#C94E16"/>
    <rect x="168" y="285" width="42" height="18" rx="5" fill="#1E1E1E"/>

    <!-- Decorative bolt details -->
    <circle cx="100" cy="152" r="3" fill="#C94E16"/>
    <circle cx="220" cy="152" r="3" fill="#C94E16"/>
    <circle cx="100" cy="240" r="3" fill="#C94E16"/>
    <circle cx="220" cy="240" r="3" fill="#C94E16"/>
  </svg>
</div>
