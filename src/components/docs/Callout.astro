---
// Callout box for use inside MDX lessons:
//   import Callout from '@/components/docs/Callout.astro';
//   <Callout type="tip" title="Heads up">Body **markdown** works here.</Callout>
interface Props {
  type?: 'note' | 'tip' | 'warning';
  title?: string;
}
const { type = 'note', title } = Astro.props;

const styles = {
  note:    { border: 'border-green',  text: 'text-green',  label: 'NOTE' },
  tip:     { border: 'border-amber',  text: 'text-amber',  label: 'TIP' },
  warning: { border: 'border-orange', text: 'text-orange', label: 'WARNING' },
} as const;
const s = styles[type];
---

<aside
  class:list={['not-prose bg-bg-card border border-bc-border border-l-2 p-4 md:p-5 my-6', s.border]}
  style="border-radius: 6px;"
>
  <p class:list={['font-mono text-xs tracking-[0.15em] uppercase mb-2', s.text]}>
    // {title ?? s.label}
  </p>
  <div class="text-bc-text text-sm leading-relaxed callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout-body :global(p) { margin: 0.4rem 0; }
  .callout-body :global(p:first-child) { margin-top: 0; }
  .callout-body :global(p:last-child) { margin-bottom: 0; }
  .callout-body :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    color: var(--color-amber);
    background: var(--color-bg-base);
    border: 1px solid var(--color-bc-border);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
  .callout-body :global(a) { color: var(--color-green-hi); }
</style>
