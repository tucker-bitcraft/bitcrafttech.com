---
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro"
import { projectList } from "@/data/client_projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
    title="Bitcraft Tech - Projects"
    description="Current projects we are working on"
>
    <main>
      <Section>
        <!-- img tag should be inline to the right of SectionHeading -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full  items-center">
          <SectionHeading
          label="// Showcasing our work"
          title="Projects"
          subtitle="Bitcraft builds software for small businesses, 
          from websites to internal tools, and everything in between. 
          Here are some of the projects we've built for our clients.",
          align="left"
        />
        
          <img
          src="Bit-Designing.png"
          alt="Bitcraft designing software"
          class="w-1/2 justify-self-start md:justify-self-end"
        />
      </div>
      <Section>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {projectList.filter((project)=>project.category == "client").map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      </Section>
      </Section>
      
    </main>
</BaseLayout>
