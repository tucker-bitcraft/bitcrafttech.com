---
import { getCollection, render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import ArticleHeader from '@/components/docs/ArticleHeader.astro';
import Resources from '@/components/docs/Resources.astro';
import { buildSidebar, prevNext, urlOf, type Entry } from '@/lib/docs';

export async function getStaticPaths() {
  const all = (await getCollection('bitsnbytes')).filter((e) => !e.data.draft);
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all },
  }));
}

interface Props {
  entry: Entry;
  all: Entry[];
}
const { entry, all } = Astro.props;

const sidebar = buildSidebar(all);
const { prev, next } = prevNext(all, entry);

// Resolve prerequisite ids to entries (silently drop unknown ids).
const byId = new Map(all.map((e) => [e.id, e]));
const prereqEntries = entry.data.prerequisites
  .map((id) => byId.get(id))
  .filter((e): e is Entry => !!e);

const { Content } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  currentId={entry.id}
>
  <article>
    <ArticleHeader entry={entry} />
    <Resources entry={entry} prereqEntries={prereqEntries} />

    <div class="prose-docs">
      <Content />
    </div>

    {entry.data.updated && (
      <p class="font-mono text-xs text-bc-muted mt-12">
        Last reviewed {entry.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    )}

    <!-- Prev / next -->
    <nav class="grid grid-cols-2 gap-4 mt-12 pt-8 border-t border-bc-border" aria-label="Pagination">
      <div>
        {prev && (
          <a href={urlOf(prev)} class="group block border border-bc-border hover:border-green transition-colors p-4" style="border-radius: 8px;">
            <span class="font-mono text-xs text-bc-muted">← Previous</span>
            <span class="block text-bc-text group-hover:text-green transition-colors mt-1">{prev.data.title}</span>
          </a>
        )}
      </div>
      <div class="text-right">
        {next && (
          <a href={urlOf(next)} class="group block border border-bc-border hover:border-green transition-colors p-4" style="border-radius: 8px;">
            <span class="font-mono text-xs text-bc-muted">Next →</span>
            <span class="block text-bc-text group-hover:text-green transition-colors mt-1">{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</DocsLayout>
