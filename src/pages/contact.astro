---
import BaseLayout from '@/layouts/BaseLayout.astro';

const inputClass =
  'w-full bg-bg-card border border-bc-border text-bc-text placeholder-bc-muted px-4 py-3 font-sans text-sm focus:outline-none focus:border-green transition-colors';
// Down-chevron background for <select> elements (matches homepage form).
const selectChevron =
  "background-image: url(\"data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%237A7065' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E\"); background-repeat: no-repeat; background-position: right 16px center;";
---

<BaseLayout
  title="Contact - Bitcraft Technologies"
  description="Tell Tucker what you're trying to build or fix. Get an honest answer, a fixed quote, and a free mockup before you commit. Based in Mesa, serving the East Valley."
>
  <main>
    <!-- ─────────────────────────────  PAGE HEADER  ───────────────────────────── -->
    <section class="relative overflow-hidden bg-bg-base">
      <div
        class="absolute top-0 left-0 right-0 h-px"
        style="background: linear-gradient(90deg, transparent, #3E8B5E, transparent);"
      ></div>
      <div
        class="absolute inset-0 opacity-40"
        style="background-image: linear-gradient(rgba(62,139,94,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(62,139,94,0.05) 1px, transparent 1px); background-size: 64px 64px;"
      ></div>

      <div class="relative max-w-7xl mx-auto px-6 pt-24 pb-14">
        <p class="font-mono text-green text-xs tracking-[0.25em] uppercase mb-6">
          // CONTACT
        </p>
        <h1 class="text-4xl md:text-6xl font-bold leading-[1.05] text-bc-text mb-6 max-w-3xl">
          Let's build<br />
          <span class="text-green text-glow-green">something.</span>
        </h1>
        <p class="text-bc-muted text-lg md:text-xl leading-relaxed max-w-2xl">
          Tell me what you're trying to fix or build. You'll get an honest answer, a
          fixed quote, and a free mockup before you commit to anything. No sales team,
          no pressure; you're emailing me directly.
        </p>
      </div>
    </section>

    <!-- ─────────────────────────────  CONTACT + FORM  ───────────────────────────── -->
    <section class="relative bg-bg-section clip-angle-both" style="padding-top: calc(5rem + 40px); padding-bottom: calc(5rem + 40px);">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-16 items-start">

          <!-- Left: info -->
          <div class="lg:col-span-2">
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 flex items-center justify-center border border-bc-border bg-bg-card flex-shrink-0 text-green" style="border-radius: 2px;">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 4h12a1 1 0 011 1v8a1 1 0 01-1 1H3a1 1 0 01-1-1V5a1 1 0 011-1z" stroke="currentColor" stroke-width="1.5"/><path d="M2 5l7 5 7-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <div>
                  <p class="font-mono text-xs text-bc-muted tracking-wide mb-1">EMAIL</p>
                  <a href="mailto:tucker@bitcrafttech.com" class="text-bc-text hover:text-green transition-colors text-sm">
                    tucker@bitcrafttech.com
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 flex items-center justify-center border border-bc-border bg-bg-card flex-shrink-0 text-green" style="border-radius: 2px;">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M9 5v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <div>
                  <p class="font-mono text-xs text-bc-muted tracking-wide mb-1">RESPONSE TIME</p>
                  <p class="text-bc-text text-sm">Within 24 hours on business days</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 flex items-center justify-center border border-bc-border bg-bg-card flex-shrink-0 text-green" style="border-radius: 2px;">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2C5.7 2 3 4.7 3 8c0 5 6 10 6 10s6-5 6-10c0-3.3-2.7-6-6-6z" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="8" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
                </div>
                <div>
                  <p class="font-mono text-xs text-bc-muted tracking-wide mb-1">LOCATION</p>
                  <p class="text-bc-text text-sm">Based in Mesa, AZ; serving the East Valley: Gilbert, Chandler, Tempe &amp; Phoenix.</p>
                </div>
              </div>
            </div>

            <!-- Process note -->
            <div class="mt-10 p-5 border border-bc-border bg-bg-card" style="border-radius: 2px;">
              <p class="font-mono text-xs text-green tracking-widest mb-3">// HOW IT WORKS</p>
              <div class="space-y-2">
                {[
                  "Tell me what you're trying to fix or build.",
                  'We discuss scope, timeline, and fit',
                  'Proposal and agreement',
                  'I start building',
                ].map((step, i) => (
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-xs text-bc-muted w-4 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
                    <span class="text-bc-muted text-sm">{step}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Right: contact form -->
          <div class="lg:col-span-3">
            <form
              id="contact-form"
              method="POST"
              action="https://formspree.io/f/xjgzdoqv"
              class="space-y-5"
            >
              <!-- Name + Business -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                    YOUR NAME <span class="text-green">*</span>
                  </label>
                  <input id="name" name="name" type="text" required placeholder="Jane Smith" class={inputClass} style="border-radius: 2px;" />
                </div>
                <div>
                  <label for="business" class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                    BUSINESS NAME
                  </label>
                  <input id="business" name="business" type="text" placeholder="Smith & Co." class={inputClass} style="border-radius: 2px;" />
                </div>
              </div>

              <!-- Email + Phone -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="email" class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                    EMAIL ADDRESS <span class="text-green">*</span>
                  </label>
                  <input id="email" name="email" type="email" required placeholder="jane@company.com" class={inputClass} style="border-radius: 2px;" />
                </div>
                <div>
                  <label for="phone" class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                    PHONE
                  </label>
                  <input id="phone" name="phone" type="tel" placeholder="(480) 555-0123" class={inputClass} style="border-radius: 2px;" />
                </div>
              </div>

              <!-- Project type -->
              <div>
                <label for="project-type" class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                  PROJECT TYPE
                </label>
                <select id="project-type" name="project-type" class={`${inputClass} appearance-none cursor-pointer`} style={`border-radius: 2px; ${selectChevron}`}>
                  <option value="" disabled selected>Select a category</option>
                  <option value="business-website">Business Website</option>
                  <option value="booking-tool">Online Booking / Quote Tool</option>
                  <option value="custom-software">Custom Software / App</option>
                  <option value="care-plan">Website Care Plan</option>
                  <option value="it-support">IT / Ongoing Support</option>
                  <option value="free-mockup">Free Mockup Request</option>
                  <option value="other">Not sure? let's talk.</option>
                </select>
              </div>

              <!-- Budget + Timeline -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="budget" class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                    BUDGET RANGE
                  </label>
                  <select id="budget" name="budget" class={`${inputClass} appearance-none cursor-pointer`} style={`border-radius: 2px; ${selectChevron}`}>
                    <option value="" disabled selected>Optional; helps me scope</option>
                    <option value="under-1k">Under $1,000</option>
                    <option value="1k-3k">$1,000 – $3,000</option>
                    <option value="3k-7k">$3,000 – $7,000</option>
                    <option value="7k-plus">$7,000+</option>
                    <option value="monthly">Monthly plan</option>
                    <option value="unsure">Not sure yet</option>
                  </select>
                </div>
                <div>
                  <label for="timeline" class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                    TIMELINE
                  </label>
                  <select id="timeline" name="timeline" class={`${inputClass} appearance-none cursor-pointer`} style={`border-radius: 2px; ${selectChevron}`}>
                    <option value="" disabled selected>When do you need it?</option>
                    <option value="asap">As soon as possible</option>
                    <option value="1-month">Within a month</option>
                    <option value="1-3-months">1 – 3 months</option>
                    <option value="flexible">Flexible / just exploring</option>
                  </select>
                </div>
              </div>

              <!-- Preferred contact method -->
              <div>
                <label class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                  PREFERRED CONTACT METHOD
                </label>
                <div class="flex flex-wrap gap-3">
                  {[
                    { value: 'email', label: 'Email' },
                    { value: 'phone', label: 'Phone call' },
                    { value: 'text', label: 'Text' },
                  ].map((opt, i) => (
                    <label class="flex items-center gap-2 cursor-pointer bg-bg-card border border-bc-border px-4 py-2.5 text-sm text-bc-text hover:border-green transition-colors" style="border-radius: 2px;">
                      <input type="radio" name="preferred-contact" value={opt.value} checked={i === 0} class="accent-[#3E8B5E]" />
                      {opt.label}
                    </label>
                  ))}
                </div>
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block font-mono text-xs text-bc-muted tracking-wide mb-2">
                  TELL ME ABOUT YOUR PROJECT <span class="text-green">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows={6}
                  placeholder="Describe what you're building, the problem you're solving, and any relevant details..."
                  class={`${inputClass} resize-none`}
                  style="border-radius: 2px;"
                ></textarea>
              </div>

              <!-- Newsletter opt-in -->
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="newsletter" value="yes" class="mt-0.5 accent-[#3E8B5E]" />
                <span class="text-bc-muted text-sm">Send me the occasional tip or update. No spam, unsubscribe anytime.</span>
              </label>

              <button
                id="contact-submit"
                type="submit"
                class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-green text-bg-base font-semibold font-mono text-sm tracking-wide glow-green hover:glow-green-hi hover:bg-green-hi transition-all duration-200 disabled:opacity-60 disabled:cursor-not-allowed"
                style="border-radius: 2px;"
              >
                Send it over
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8h12M9 4l5 4-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <!-- Error message shown only if the submit fails. -->
              <p id="contact-error" role="alert" hidden class="font-mono text-xs text-orange text-center mt-3">
                Something went wrong sending your message. Please try again, or email
                <a href="mailto:tucker@bitcrafttech.com" class="underline hover:text-green-hi transition-colors">tucker@bitcrafttech.com</a>.
              </p>

              <p class="font-mono text-xs text-bc-muted text-center mt-3">
                Or email directly: <a href="mailto:tucker@bitcrafttech.com" class="text-green hover:text-green-hi transition-colors">tucker@bitcrafttech.com</a>
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Submit the form via fetch so we can redirect to /callback on success
  // without leaving the domain. Formspree returns JSON when we ask for it.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const errorMsg = document.getElementById('contact-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMsg?.setAttribute('hidden', '');
    if (submitBtn) submitBtn.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        window.location.assign('/callback');
        return;
      }
      throw new Error(`Formspree responded ${response.status}`);
    } catch (err) {
      console.error('Contact form submission failed:', err);
      errorMsg?.removeAttribute('hidden');
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
