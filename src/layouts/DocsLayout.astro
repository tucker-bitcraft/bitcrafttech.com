---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@/components/docs/Sidebar.astro';
import type { SidebarSection } from '@/lib/docs';

interface Props {
  title: string;
  description: string;
  sidebar: SidebarSection[];
  /** Collection id of the active page; undefined on the index. */
  currentId?: string;
}

const { title, description, sidebar, currentId } = Astro.props;
const pageTitle = `${title} - Bits & Bytes | Bitcraft Tech`;
---

<BaseLayout title={pageTitle} description={description}>
  <div class="max-w-[90rem] mx-auto px-4 md:px-6" style="padding-top: calc(4rem + 24px);">
    <div class="md:grid md:grid-cols-[16rem_minmax(0,1fr)] lg:grid-cols-[17rem_minmax(0,1fr)] md:gap-10 lg:gap-16">
      <!-- Sidebar: sticky on desktop -->
      <aside class="hidden md:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-16 pr-2 docs-scroll">
          <Sidebar sidebar={sidebar} currentId={currentId} />
        </div>
      </aside>

      <!-- Mobile: collapsible directory -->
      <details class="md:hidden mb-8 border border-bc-border bg-bg-section" style="border-radius: 5px;">
        <summary class="list-none cursor-pointer px-4 py-3 font-mono text-sm text-bc-text flex items-center justify-between">
          <span>Directory</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="transition-transform"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="px-4 pb-4 border-t border-bc-border pt-4">
          <Sidebar sidebar={sidebar} currentId={currentId} />
        </div>
      </details>

      <main class="min-w-0 pb-24">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* ------------------------------------------------------------------ */
  /* Prose styling for rendered MDX. Tailwind base is disabled site-wide */
  /* (applyBaseStyles: false), so docs markup is styled explicitly here. */
  /* ------------------------------------------------------------------ */
  .prose-docs {
    color: var(--color-bc-text);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .prose-docs > :first-child { margin-top: 0; }

  .prose-docs h2,
  .prose-docs h3,
  .prose-docs h4 {
    color: var(--color-bc-text);
    font-weight: 700;
    line-height: 1.25;
    scroll-margin-top: 6rem;
  }
  .prose-docs h2 {
    font-size: 1.7rem;
    margin: 2.75rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-bc-border);
  }
  .prose-docs h3 { font-size: 1.3rem; margin: 2rem 0 0.75rem; }
  .prose-docs h4 { font-size: 1.08rem; margin: 1.5rem 0 0.5rem; }

  /* Anchor links auto-added to headings */
  .prose-docs :is(h2, h3, h4) > a {
    color: inherit;
    text-decoration: none;
  }
  .prose-docs :is(h2, h3, h4) > a:hover { color: var(--color-green-hi); }

  .prose-docs p { margin: 1rem 0; }
  .prose-docs a {
    color: var(--color-green-hi);
    text-decoration: none;
    border-bottom: 1px solid var(--color-bc-border-hi);
    transition: border-color 0.15s;
  }
  .prose-docs a:hover { border-bottom-color: var(--color-green-hi); }

  .prose-docs ul,
  .prose-docs ol { margin: 1rem 0; padding-left: 1.4rem; }
  .prose-docs ul { list-style: none; }
  .prose-docs ul > li { position: relative; }
  .prose-docs ul > li::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 0.7rem;
    width: 6px;
    height: 6px;
    background: var(--color-green);
    border-radius: 1px;
  }
  .prose-docs ol { list-style: decimal; }
  .prose-docs ol::marker { color: var(--color-bc-muted); }
  .prose-docs li { margin: 0.4rem 0; }
  .prose-docs li > ul,
  .prose-docs li > ol { margin: 0.4rem 0; }

  .prose-docs strong { color: var(--color-bc-text); font-weight: 600; }

  /* Inline code */
  .prose-docs :not(pre) > code {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.85em;
    color: var(--color-amber);
    background: var(--color-bg-card);
    border: 1px solid var(--color-bc-border);
    padding: 0.12em 0.4em;
    border-radius: 3px;
  }

  /* Shiki code blocks */
  .prose-docs .astro-code {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.88rem;
    line-height: 1.65;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    padding: 1.15rem 1.25rem;
    margin: 0;
    overflow-x: auto;
    background: #131313 !important;
  }
  /* Wrapper injected by the copy-button script */
  .code-block {
    position: relative;
    margin: 1.5rem 0;
  }
  .code-copy-btn {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #7A7065;
    background: #1E1E1E;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
    padding: 0.28rem 0.6rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s, border-color 0.15s;
  }
  .code-block:hover .code-copy-btn,
  .code-copy-btn:focus-visible { opacity: 1; }
  .code-copy-btn:hover { color: #4CAF75; border-color: #3E8B5E; }
  .code-copy-btn.copied { color: #4CAF75; border-color: #3E8B5E; opacity: 1; }

  .prose-docs blockquote {
    margin: 1.5rem 0;
    padding: 0.25rem 1.1rem;
    border-left: 3px solid var(--color-green);
    color: var(--color-bc-muted);
    font-style: italic;
  }

  .prose-docs hr {
    border: none;
    border-top: 1px solid var(--color-bc-border);
    margin: 2.5rem 0;
  }

  .prose-docs img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--color-bc-border);
    margin: 1.5rem 0;
  }

  /* Tables */
  .prose-docs table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
  }
  .prose-docs th,
  .prose-docs td {
    border: 1px solid var(--color-bc-border);
    padding: 0.55rem 0.85rem;
    text-align: left;
  }
  .prose-docs th {
    background: var(--color-bg-card);
    color: var(--color-bc-text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Thin scrollbar on the sticky sidebar */
  .docs-scroll::-webkit-scrollbar { width: 6px; }
  .docs-scroll::-webkit-scrollbar-thumb { background: var(--color-bc-border); border-radius: 3px; }
  .docs-scroll::-webkit-scrollbar-thumb:hover { background: var(--color-bc-border-hi); }
</style>

<script>
  // Progressive enhancement: wrap every code block in a positioned container
  // and add a copy-to-clipboard button. Site is otherwise zero-JS.
  document.querySelectorAll<HTMLPreElement>('.prose-docs pre.astro-code').forEach((pre) => {
    if (pre.parentElement?.classList.contains('code-block')) return;
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    wrap.appendChild(btn);

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = 'Copied';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 1600);
      } catch {
        btn.textContent = 'Error';
      }
    });
  });
</script>
